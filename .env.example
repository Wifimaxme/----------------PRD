# Адрес приёмника заявок с формы /signup: роут /api/leads на бэкенде ЛК.
# По умолчанию в коде зашит https://lk.champion-footboll.ru/api/leads,
# переменная нужна только чтобы направить форму на тестовый бэкенд.
#
# Переменные с префиксом VITE_ попадают в бандл и видны всем посетителям:
# ключей и паролей здесь быть не должно.
VITE_LEADS_ENDPOINT=https://lk.champion-footboll.ru/api/leads
